# Default deny: this is a selective review artifact, not a workspace mirror.
*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/requirements-torch.txt
!/cogadapt/
!/cogadapt/*.py
!/scripts/
!/scripts/*.py
!/tests/
!/tests/*.py
!/docs/
!/docs/*.md
!/configs/
!/configs/*.json
!/provenance/
!/provenance/*.json
!/results/
!/results/rq1/
!/results/rq2/
!/results/rq3/
!/results/rq1/*.csv
!/results/rq2/*.csv
!/results/rq3/*.csv
!/results/rq3/*.json

# Never distribute recordings, checkpoints, or environments.
**/__pycache__/
**/.env*
**/*.fif
**/*.edf
**/*.safetensors
**/*.pt
**/*.pth
**/*.npz
**/*.parquet
/.venv/
/.pytest_cache/

# Publish only the selected RQ1 figure; other renderings remain ignored.
!/figures/
!/figures/region_retention/
!/figures/region_retention/figure4_retained_four_categories.png
!/figures/region_retention/figure4_retained_four_categories.pdf
